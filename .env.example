# EP-Governance Configuration
# Copy to .env and adjust.  In production use a secret manager, not a repo-adjacent .env.

# Operating mode
EP_MODE=enforced
# EP_MODE=advisory

# Database
EP_DB_URL=postgresql://ep_user:CHANGE_ME@localhost:5432/ep_governance
# EP_DB_URL=sqlite:///./ep-governance.db

# Embeddings (optional — policy authoring/discovery ONLY, never enforcement)
EP_EMBEDDING_PROVIDER=none
# EP_EMBEDDING_PROVIDER=ollama
# EP_EMBEDDING_MODEL=bge-m3
# EP_EMBEDDING_HOST=localhost:11434
# EP_EMBEDDING_PROVIDER=openai
# EP_EMBEDDING_API_KEY=sk-...

# MCP transport
EP_MCP_TRANSPORT=stdio
# EP_MCP_TRANSPORT=http
# EP_MCP_PORT=8200

# Notifications
EP_NOTIFY=native
# EP_NOTIFY=nats
# EP_NATS_URL=nats://your-nats-host:4222
# EP_NOTIFY=none

# Authorization token
EP_TOKEN_TTL_SECONDS=300

# HTTP MCP security (when EP_MCP_TRANSPORT=http)
# EP_MCP_TLS_CERT=/path/to/cert.pem
# EP_MCP_TLS_KEY=/path/to/key.pem
# EP_MCP_ALLOWED_HOSTS=100.96.163.59,127.0.0.1

# Development
# EP_DEV=true  (enables self-registration, advisory mode)

# ----------------------------------------------------------------------
# Governed PostgreSQL proxy (for Docker Compose deployment)
# These variables are required when using docker/proxy/docker-compose.proxy.yml
# Copy to .env.proxy and fill in real values. Keep .env.proxy in .gitignore.
# ----------------------------------------------------------------------

# Governance DB (where EP stores policies, transitions, audit)
EP_DB_URL=postgresql://ep_governance_runtime:CHANGE_ME@db:5432/ep_governance

# Target DB (what the proxy executes against; agent does NOT have these creds)
EP_PROXY_TARGET_URL=postgresql://ep_proxy_runtime:CHANGE_ME@target-db:5432/application

# Required attestation bindings (all four mandatory)
EP_PROXY_AUDIENCE=postgres-proxy
EP_PROXY_PRINCIPAL_ID=proxy-production-01
EP_DEPLOYMENT_ID=deployment-production-01
EP_PROXY_TARGET_ID=target-postgres-01

# EP service identity
EP_EP_SERVICE_ID=ep-service-principal-xid

# Governance token verification (public key only — proxy cannot mint tokens)
EP_PUBLIC_KEY=<governance-token-verification-public-key-hex>

# Controller attestation verification (public key of trusted deployment controller)
EP_CONTROLLER_PUBLIC_KEY=<controller-attestation-verification-public-key-hex>

# Host path to signed attestation JSON file (mounted read-only into container)
EP_PROXY_ATTESTATION_FILE=/secure/path/proxy-attestation.json
