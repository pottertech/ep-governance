# EP-Governance Proxy Environment Template
#
# SAFETY REQUIREMENTS:
# 1. NEVER commit this file with real credentials. Keep it in .gitignore.
# 2. Set file permissions to 0600: chmod 600 .env.proxy
# 3. Prefer Docker secrets, systemd credentials, HashiCorp Vault, or another
#    secret manager over plaintext .env files.
# 4. URL-encode special characters in passwords (e.g., %2F for /, %40 for @).
# 5. Rotate all credentials derived from templates or examples before production.
# 6. Use separate database accounts for governance DB and target DB.
# 7. Do not expose credentials through process listings (ps aux) or shell history.
# 8. The agent must NOT have access to this file or these credentials.
#
# COMPONENT: Governed Proxy (runs as separate process/container)
# The proxy verifies tokens and executes SQL against the target database.

# --- Governance DB (where EP stores policies, transitions, audit) ---
EP_DB_URL=<required-governance-database-url>
EP_DB_SCHEMA=ep_governance

# --- Target DB (where the proxy executes SQL on behalf of agents) ---
# The proxy uses these credentials; the agent does NOT have them.
EP_PROXY_TARGET_URL=<required-target-database-url>

# --- Required attestation bindings (all four mandatory) ---
EP_PROXY_AUDIENCE=postgres-proxy
EP_PROXY_PRINCIPAL_ID=<proxy-principal-xid>
EP_DEPLOYMENT_ID=<deployment-identifier>
EP_PROXY_TARGET_ID=<target-system-identifier>

# --- EP service identity ---
EP_EP_SERVICE_ID=<ep-service-principal-xid>

# --- Governance token verification (public key only) ---
# The proxy only has the PUBLIC key — it cannot mint tokens.
# Generate with: python -c "from ep_governance.authorizations import KeyManager; km = KeyManager(); print(bytes(km.public_key).hex())"
EP_PUBLIC_KEY=<governance-token-verification-public-key-hex>

# --- Controller attestation verification ---
# Hex-encoded Ed25519 public key of the trusted deployment controller.
EP_CONTROLLER_PUBLIC_KEY=<controller-attestation-verification-public-key-hex>

# --- Signed attestation file (host path, mounted read-only into container) ---
EP_PROXY_ATTESTATION_FILE=<host-path-to-attestation-json>

# --- TLS (optional but recommended for production) ---
# EP_PROXY_TLS_CERT=/run/ep-governance/tls/proxy.crt
# EP_PROXY_TLS_KEY=/run/ep-governance/tls/proxy.key

# --- Rate limiting (requests per window per client IP) ---
EP_PROXY_RATE_LIMIT=30
EP_PROXY_RATE_WINDOW=60
