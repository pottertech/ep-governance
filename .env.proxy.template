# EP-Governance Proxy .env template
# Copy to .env.proxy and fill in real values before deploying to NAS

# Governance DB (NAS PostgreSQL)
EP_DB_URL=postgresql://gbrain_pilot_test_user:PASSWORD@127.0.0.1:5433/gbrain_pilot_test
EP_DB_SCHEMA=ep_governance
EP_MODE=enforced

# Target DB (what the proxy executes SQL against)
# This is the database the agent wants to query/mutate
# The proxy holds these credentials, the agent does NOT
EP_PROXY_TARGET_URL=postgresql://ep_proxy_user:change_me_in_production@127.0.0.1:5433/gbrain_pilot_test

# Proxy configuration
EP_PROXY_AUDIENCE=postgres-proxy
EP_PROXY_PORT=8201

# EP service principal XID
EP_EP_SERVICE_ID=d9ll4o7ug6j0oak02ck0

# Ed25519 public key for token verification (hex-encoded)
# The proxy only has the PUBLIC key — it cannot mint tokens
# Generate with: python -c "from ep_governance.authorizations import KeyManager; km = KeyManager(); print(bytes(km.public_key).hex())"
EP_PUBLIC_KEY=